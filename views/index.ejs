<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Hair Specialist Gleyci Felix | Lisboa</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

  <nav>
    <div class="logo">GLEYCI FELIX</div>
    <ul>
      <li><a href="#home"><%= T.nav_home %></a></li>
      <li><a href="#gallery"><%= T.nav_gallery %></a></li>
      <li><a href="#services"><%= T.nav_services %></a></li>
      <li><a href="#booking"><%= T.nav_booking %></a></li>
    </ul>
    <div class="nav-actions">
      <span class="lang-switch" onclick="location.href='/set-lang/<%= lang === 'pt' ? 'en' : 'pt' %>'"><%= lang === 'pt' ? 'EN' : 'PT' %></span>
      <% if (user) { %>
        <span style="color:#F7F1E8; font-size:0.9rem;"><%= user.name.split(' ')[0] %></span>
        <button onclick="logout()"><%= T.logout %></button>
      <% } else { %>
        <button onclick="openModal('login')"><%= T.login %></button>
      <% } %>
    </div>
  </nav>

  <section class="hero" id="home">
    <div class="hero-content">
      <span><%= T.hero_tag %></span>
      <h1><%= T.hero_title %></h1>
      <p><%= T.hero_sub %></p>
      <button class="hero-btn" onclick="document.getElementById('booking').scrollIntoView({behavior:'smooth'})"><%= T.hero_btn %></button>
    </div>
  </section>

  <section id="gallery" class="fade-section">
    <div class="section-title">
      <span><%= T.gallery_tag %></span>
      <h2><%= T.gallery_title %></h2>
    </div>
    <div class="gallery-grid" id="galleryGrid">
      <!-- Placeholders: serão substituídos pelas fotos/vídeos reais do Instagram -->
      <div class="gallery-item"><img src="/images/placeholder-1.jpg" alt="Trabalho de cabelo"></div>
      <div class="gallery-item"><img src="/images/placeholder-2.jpg" alt="Trabalho de cabelo"></div>
      <div class="gallery-item"><img src="/images/placeholder-3.jpg" alt="Trabalho de cabelo"></div>
      <div class="gallery-item"><img src="/images/placeholder-4.jpg" alt="Trabalho de cabelo"></div>
      <div class="gallery-item"><img src="/images/placeholder-5.jpg" alt="Trabalho de cabelo"></div>
      <div class="gallery-item"><img src="/images/placeholder-6.jpg" alt="Trabalho de cabelo"></div>
    </div>
  </section>

  <section id="services" class="fade-section" style="background:white;">
    <div class="section-title">
      <span><%= T.services_tag %></span>
      <h2><%= T.services_title %></h2>
    </div>
    <div class="services-grid">
      <% services.forEach(s => { %>
        <div class="service-card">
          <h3><%= lang === 'pt' ? s.name_pt : s.name_en %></h3>
          <p><%= lang === 'pt' ? s.description_pt : s.description_en %></p>
          <div class="price">€<%= parseFloat(s.price).toFixed(0) %></div>
          <div class="duration"><%= s.duration_minutes %> min</div>
        </div>
      <% }) %>
    </div>
  </section>

  <section id="booking" class="fade-section">
    <div class="section-title">
      <span><%= T.booking_tag %></span>
      <h2><%= T.booking_title %></h2>
    </div>
    <div class="booking-box">
      <div class="booking-step">
        <label><%= T.step_service %></label>
        <select id="serviceSelect">
          <option value=""><%= T.select_placeholder %></option>
          <% services.forEach(s => { %>
            <option value="<%= s.id %>"><%= lang === 'pt' ? s.name_pt : s.name_en %> — €<%= parseFloat(s.price).toFixed(0) %></option>
          <% }) %>
        </select>
      </div>
      <div class="booking-step">
        <label><%= T.step_date %></label>
        <input type="date" id="dateInput">
      </div>
      <div class="booking-step">
        <label><%= T.step_time %></label>
        <div class="slots-grid" id="slotsGrid"></div>
      </div>
      <button class="confirm-btn" id="confirmBtn" onclick="confirmBooking()" disabled><%= T.confirm %></button>
    </div>
  </section>

  <div class="floating-buttons">
    <a href="https://wa.link/SUBSTITUIR" target="_blank" style="background:#25D366;">
      <svg width="26" height="26" viewBox="0 0 24 24" fill="white"><path d="M12 2C6.48 2 2 6.48 2 12c0 1.85.5 3.58 1.36 5.07L2 22l5.07-1.32A9.94 9.94 0 0012 22c5.52 0 10-4.48 10-10S17.52 2 12 2zm0 18c-1.6 0-3.1-.44-4.38-1.2l-.31-.19-3.01.79.8-2.93-.2-.3A7.97 7.97 0 014 12c0-4.41 3.59-8 8-8s8 3.59 8 8-3.59 8-8 8z"/></svg>
    </a>
    <a href="https://www.instagram.com/hairstudiogleycifelix/" target="_blank" style="background:linear-gradient(45deg,#f09433,#e6683c,#dc2743,#cc2366,#bc1888);">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="white"><path d="M12 2.16c3.2 0 3.58.01 4.85.07 3.25.15 4.77 1.69 4.92 4.92.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.15 3.23-1.66 4.77-4.92 4.92-1.27.06-1.64.07-4.85.07s-3.58-.01-4.85-.07c-3.26-.15-4.77-1.7-4.92-4.92-.06-1.27-.07-1.65-.07-4.85s.01-3.58.07-4.85C2.38 3.9 3.9 2.38 7.15 2.23 8.42 2.17 8.8 2.16 12 2.16zM12 0C8.74 0 8.33.01 7.05.07c-4.35.2-6.78 2.62-6.98 6.98C.01 8.33 0 8.74 0 12s.01 3.67.07 4.95c.2 4.35 2.62 6.78 6.98 6.98C8.33 23.99 8.74 24 12 24s3.67-.01 4.95-.07c4.35-.2 6.78-2.62 6.98-6.98.06-1.28.07-1.69.07-4.95s-.01-3.67-.07-4.95c-.2-4.35-2.62-6.78-6.98-6.98C15.67.01 15.26 0 12 0zm0 5.84A6.16 6.16 0 1018.16 12 6.16 6.16 0 0012 5.84zm0 10.16A4 4 0 1116 12a4 4 0 01-4 4zm6.41-10.4a1.44 1.44 0 11-1.44-1.44 1.44 1.44 0 011.44 1.44z"/></svg>
    </a>
  </div>

  <footer>
    <div class="logo">GLEYCI FELIX</div>
    <p>Lisboa, Portugal · &copy; <%= new Date().getFullYear() %> Hair Specialist Gleyci Felix. <%= T.footer_rights %></p>
  </footer>

  <!-- Modal Login/Registo -->
  <div class="modal-overlay" id="authModal">
    <div class="modal-box">
      <span class="modal-close" onclick="closeModal()">&times;</span>
      <div id="loginForm">
        <h2><%= T.login_title %></h2>
        <input type="email" id="loginEmail" placeholder="<%= T.email %>">
        <input type="password" id="loginPassword" placeholder="<%= T.password %>">
        <div class="form-error" id="loginError"></div>
        <button class="submit-btn" onclick="doLogin()"><%= T.login %></button>
        <div class="modal-switch" onclick="switchForm('register')"><%= T.no_account %></div>
      </div>
      <div id="registerForm" style="display:none;">
        <h2><%= T.register_title %></h2>
        <input type="text" id="regName" placeholder="<%= T.name %>">
        <input type="email" id="regEmail" placeholder="<%= T.email %>">
        <input type="text" id="regPhone" placeholder="<%= T.phone %>">
        <input type="password" id="regPassword" placeholder="<%= T.password %>">
        <div class="form-error" id="regError"></div>
        <button class="submit-btn" onclick="doRegister()"><%= T.register_title %></button>
        <div class="modal-switch" onclick="switchForm('login')"><%= T.have_account %></div>
      </div>
    </div>
  </div>

  <script>
    const LANG = "<%= lang %>";
    const IS_LOGGED_IN = <%= user ? 'true' : 'false' %>;
    const MSG_NO_SLOTS = "<%= T.no_slots %>";
    const MSG_SUCCESS = "<%= T.booking_success %>";
  </script>
  <script src="/js/main.js"></script>
</body>
</html>
