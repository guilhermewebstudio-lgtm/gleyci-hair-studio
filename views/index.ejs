<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Hair Specialist Gleyci Felix | Lisboa</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,500;1,9..144,600&family=Work+Sans:wght@300;400;500;600&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

  <!-- ABERTURA / INTRO ANIMADA -->
  <div class="intro-overlay" id="introOverlay">
    <div class="intro-logo">
      <svg width="72" height="72" viewBox="0 0 72 72" fill="none">
        <circle cx="36" cy="36" r="34.5" stroke="#D4AF6A" stroke-width="1"/>
        <circle cx="36" cy="36" r="29.5" stroke="#D4AF6A" stroke-width="0.5" opacity="0.5"/>
        <text x="36" y="46" text-anchor="middle" font-family="Fraunces, serif" font-style="italic" font-size="30" fill="#FBF4EA">GF</text>
      </svg>
    </div>
    <div class="intro-wordmark">Gleyci Felix</div>
    <div class="intro-rule"></div>
    <div class="intro-sub">Hair Specialist · Lisboa</div>
    <div class="intro-pulse"></div>
  </div>

  <nav id="mainNav">
    <a href="#home" class="brand" style="text-decoration:none; cursor:pointer;" onclick="replayIntro()">
      <svg class="brand-mark" viewBox="0 0 72 72" fill="none">
        <circle class="ring" cx="36" cy="36" r="34.5"/>
        <text x="36" y="46" text-anchor="middle" font-size="30">GF</text>
      </svg>
      <span class="brand-word" style="color:var(--parchment); font-size:1.15rem;">Gleyci Felix</span>
    </a>
    <ul id="navLinks">
      <li><a href="#gallery"><%= T.nav_gallery %></a></li>
      <li><a href="#services"><%= T.nav_services %></a></li>
      <li><a href="#location"><%= T.nav_location %></a></li>
      <li><a href="#hours"><%= T.nav_hours %></a></li>
      <li><a href="#booking"><%= T.nav_booking %></a></li>
      <li class="nav-mobile-extra">
        <a href="https://www.google.com/maps/place/Hair+Studio+Gleyci+Felix/@38.7540797,-9.2056008,17z/data=!3m1!5s0xd1ecd26bac31815:0xc9383e256167793b!4m8!3m7!1s0xd1933392ee64dd3:0xbe77e6a59a2a475d!8m2!3d38.7540797!4d-9.2056008!9m1!1b1!16s%2Fg%2F11lkjp8kcp?entry=ttu"
           target="_blank" rel="noopener"><%= T.rate_us %></a>
      </li>
      <li class="nav-mobile-extra nav-mobile-lang">
        <a href="/set-lang/pt" class="<%= lang === 'pt' ? 'active' : '' %>">PT</a>
        <span>/</span>
        <a href="/set-lang/en" class="<%= lang === 'en' ? 'active' : '' %>">EN</a>
      </li>
      <% if (user) { %>
        <% if (user.is_admin) { %>
          <li class="nav-mobile-extra"><a href="/gestao"><%= lang === 'pt' ? 'Gestão' : 'Admin' %></a></li>
        <% } %>
        <li class="nav-mobile-extra"><a href="#" onclick="openMyBookings(); return false;"><%= user.name.split(' ')[0] %></a></li>
        <li class="nav-mobile-extra"><a href="#" onclick="logout(); return false;"><%= T.logout %></a></li>
      <% } else { %>
        <li class="nav-mobile-extra"><a href="#" onclick="openModal('login'); return false;"><%= T.login %></a></li>
      <% } %>
    </ul>
    <div class="nav-actions">
      <a href="https://www.google.com/maps/place/Hair+Studio+Gleyci+Felix/@38.7540797,-9.2056008,17z/data=!3m1!5s0xd1ecd26bac31815:0xc9383e256167793b!4m8!3m7!1s0xd1933392ee64dd3:0xbe77e6a59a2a475d!8m2!3d38.7540797!4d-9.2056008!9m1!1b1!16s%2Fg%2F11lkjp8kcp?entry=ttu"
         target="_blank" rel="noopener" class="pill-btn rate-btn desktop-only"><%= T.rate_us %></a>
      <div class="lang-toggle desktop-only">
        <button class="<%= lang === 'pt' ? 'active' : '' %>" onclick="location.href='/set-lang/pt'">PT</button>
        <button class="<%= lang === 'en' ? 'active' : '' %>" onclick="location.href='/set-lang/en'">EN</button>
      </div>
      <% if (user) { %>
        <% if (user.is_admin) { %>
          <a href="/gestao" class="pill-btn desktop-only" style="text-decoration:none; display:inline-block;"><%= lang === 'pt' ? 'Gestão' : 'Admin' %></a>
        <% } %>
        <span class="desktop-only" style="color:#FBF4EA; font-size:0.85rem; font-family:'Space Mono',monospace; cursor:pointer;" onclick="openMyBookings()"><%= user.name.split(' ')[0] %></span>
        <button class="pill-btn desktop-only" onclick="logout()"><%= T.logout %></button>
      <% } else { %>
        <button class="pill-btn desktop-only" onclick="openModal('login')"><%= T.login %></button>
      <% } %>
      <button class="hamburger" id="hamburgerBtn" aria-label="Menu"><span></span><span></span><span></span></button>
    </div>
  </nav>
  <div class="nav-scrim" id="navScrim"></div>

  <section class="hero" id="home">
    <div class="hero-content">
      <span class="eyebrow"><%= T.hero_tag %></span>
      <h1><%= lang === 'pt' ? 'Beleza e cor com técnica ' : 'Beauty and color with the ' %><em>Toni&Guy</em><%= lang === 'pt' ? '' : ' technique' %></h1>
      <p><%= T.hero_sub %></p>
      <button class="hero-btn" onclick="document.getElementById('booking').scrollIntoView({behavior:'smooth'})"><%= T.hero_btn %></button>
    </div>
    <div class="scroll-cue" aria-hidden="true"></div>
  </section>

  <section id="gallery" class="fade-section">
    <div class="section-title">
      <span class="eyebrow"><%= T.gallery_tag %></span>
      <h2><%= T.gallery_title %></h2>
      <div class="section-line"></div>
    </div>
    <div class="gallery-grid" id="galleryGrid">
      <div class="gallery-item stagger-item"><img src="/images/gallery/hair-work-1.png" alt="Trabalho de cor - Gleyci Felix" loading="lazy"></div>
      <div class="gallery-item stagger-item"><img src="/images/gallery/hair-work-2.png" alt="Trabalho de cor - Gleyci Felix" loading="lazy"></div>
      <div class="gallery-item stagger-item"><img src="/images/gallery/interior-salon.png" alt="Interior do estúdio Gleyci Felix" loading="lazy"></div>
      <div class="gallery-item stagger-item"><img src="/images/gallery/hair-work-3.png" alt="Trabalho de cor - Gleyci Felix" loading="lazy"></div>
      <div class="gallery-item stagger-item"><img src="/images/gallery/hair-work-4.png" alt="Trabalho de cor - Gleyci Felix" loading="lazy"></div>
      <div class="gallery-item stagger-item"><img src="/images/gallery/hair-work-5.png" alt="Trabalho de cor - Gleyci Felix" loading="lazy"></div>
    </div>
  </section>

  <section id="services" class="fade-section">
    <div class="section-title">
      <span class="eyebrow"><%= T.services_tag %></span>
      <h2><%= T.services_title %></h2>
      <div class="section-line"></div>
    </div>
    <div class="services-grid">
      <% const tones = ['#3A2418','#6B4A32','#A97C4F','#D4AF6A','#C97B63','#7A2E3A','#8B4C36','#241A14']; %>
      <% services.forEach((s, i) => { %>
        <div class="service-card stagger-item">
          <div class="tone-dot" style="background:<%= tones[i % tones.length] %>;"></div>
          <h3><%= lang === 'pt' ? s.name_pt : s.name_en %></h3>
          <p><%= lang === 'pt' ? s.description_pt : s.description_en %></p>
          <div class="price-row">
            <span class="price">€<%= parseFloat(s.price).toFixed(0) %></span>
            <span class="duration"><%= s.duration_minutes %> min</span>
          </div>
        </div>
      <% }) %>
    </div>
  </section>

  <section id="location" class="fade-section">
    <div class="section-title">
      <span class="eyebrow"><%= T.location_tag %></span>
      <h2 style="color:var(--parchment);"><%= T.location_title %></h2>
      <div class="section-line" style="background:rgba(247,242,233,0.15);"></div>
    </div>
    <div class="location-grid">
      <div class="location-map">
        <iframe
          src="https://www.google.com/maps?q=R.+das+Pedralvas+15,+1500-487+Lisboa&output=embed"
          width="100%" height="100%" style="border:0;" allowfullscreen="" loading="lazy"
          referrerpolicy="no-referrer-when-downgrade" title="Localização Gleyci Felix Hair Studio">
        </iframe>
      </div>
      <div class="location-info">
        <h3><%= T.address_title %></h3>
        <p class="location-address"><%= T.address_placeholder %></p>
        <a href="https://www.google.com/maps/place/Hair+Studio+Gleyci+Felix/@38.7540797,-9.2056008,17z/data=!3m1!5s0xd1ecd26bac31815:0xc9383e256167793b!4m8!3m7!1s0xd1933392ee64dd3:0xbe77e6a59a2a475d!8m2!3d38.7540797!4d-9.2056008!9m1!1b1!16s%2Fg%2F11lkjp8kcp?entry=ttu" target="_blank" rel="noopener" class="location-link"><%= T.open_maps %> →</a>
      </div>
    </div>
  </section>

  <section id="hours" class="fade-section">
    <div class="section-title">
      <span class="eyebrow"><%= T.hours_tag %></span>
      <h2><%= T.hours_section_title %></h2>
      <div class="section-line"></div>
    </div>
    <div class="hours-table">
      <% hours.forEach(h => { %>
        <div class="hours-day-row" data-weekday="<%= h.weekday %>">
          <span class="hours-day-name"><%= lang === 'pt' ? h.name : h.name_en %><span class="today-tag" style="display:none;"><%= T.today_label %></span></span>
          <span class="hours-day-time <%= h.active ? '' : 'closed' %>">
            <%= h.active ? h.start_time + ' – ' + h.end_time : T.closed_label %>
          </span>
        </div>
      <% }) %>
    </div>
  </section>

  <section id="booking" class="fade-section">
    <div class="section-title">
      <span class="eyebrow"><%= T.booking_tag %></span>
      <h2><%= T.booking_title %></h2>
      <div class="section-line"></div>
    </div>
    <div class="booking-box">
      <div class="booking-progress">
        <div class="dot" id="progDot1"><i></i></div>
        <div class="dot" id="progDot2"><i></i></div>
        <div class="dot" id="progDot3"><i></i></div>
      </div>
      <div class="booking-step">
        <label><span class="step-num">1</span><%= T.step_service %></label>
        <select id="serviceSelect">
          <option value=""><%= T.select_placeholder %></option>
          <% services.forEach(s => { %>
            <option value="<%= s.id %>"><%= lang === 'pt' ? s.name_pt : s.name_en %> — €<%= parseFloat(s.price).toFixed(0) %></option>
          <% }) %>
        </select>
      </div>
      <div class="booking-step">
        <label><span class="step-num">2</span><%= T.step_date %></label>
        <input type="date" id="dateInput">
      </div>
      <div class="booking-step">
        <label><span class="step-num">3</span><%= T.step_time %></label>
        <div class="slots-grid" id="slotsGrid"></div>
      </div>
      <button class="confirm-btn" id="confirmBtn" onclick="confirmBooking()" disabled><%= T.confirm %></button>
      <div class="booking-note"><%= T.booking_note %></div>
    </div>
  </section>

  <div class="floating-buttons">
    <a href="https://www.instagram.com/hairstudiogleycifelix/" target="_blank" aria-label="Instagram" style="background:radial-gradient(circle at 30% 107%, #fdf497 0%, #fdf497 5%, #fd5949 45%,#d6249f 60%,#285AEB 90%);">
      <svg width="26" height="26" viewBox="0 0 448 512" fill="white"><path d="M224.1 141c-63.6 0-114.9 51.3-114.9 114.9s51.3 114.9 114.9 114.9S339 319.5 339 255.9 287.7 141 224.1 141zm0 189.6c-41.1 0-74.7-33.5-74.7-74.7s33.5-74.7 74.7-74.7 74.7 33.5 74.7 74.7-33.6 74.7-74.7 74.7zm146.4-194.3c0 14.9-12 26.8-26.8 26.8-14.9 0-26.8-12-26.8-26.8s12-26.8 26.8-26.8 26.8 12 26.8 26.8zm76.1 27.2c-1.7-35.9-9.9-67.7-36.2-93.9-26.2-26.2-58-34.4-93.9-36.2-37-2.1-147.9-2.1-184.9 0-35.8 1.7-67.6 9.9-93.9 36.1s-34.4 58-36.2 93.9c-2.1 37-2.1 147.9 0 184.9 1.7 35.9 9.9 67.7 36.2 93.9s58 34.4 93.9 36.2c37 2.1 147.9 2.1 184.9 0 35.9-1.7 67.7-9.9 93.9-36.2 26.2-26.2 34.4-58 36.2-93.9 2.1-37 2.1-147.8 0-184.8zM398.8 388c-7.8 19.6-22.9 34.7-42.6 42.6-29.5 11.7-99.5 9-132.1 9s-102.7 2.6-132.1-9c-19.6-7.8-34.7-22.9-42.6-42.6-11.7-29.5-9-99.5-9-132.1s-2.6-102.7 9-132.1c7.8-19.6 22.9-34.7 42.6-42.6 29.5-11.7 99.5-9 132.1-9s102.7-2.6 132.1 9c19.6 7.8 34.7 22.9 42.6 42.6 11.7 29.5 9 99.5 9 132.1s2.7 102.7-9 132.1z"/></svg>
    </a>
    <button class="chat-toggle" id="chatToggle" aria-label="Chat" style="background:var(--ink); border:2px solid var(--gold);">
      <svg id="chatIconOpen" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#FBF4EA" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 01-.9 3.8 8.5 8.5 0 01-7.6 4.7 8.38 8.38 0 01-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 01-.9-3.8 8.5 8.5 0 014.7-7.6 8.38 8.38 0 013.8-.9h.5a8.48 8.48 0 018 8v.5z"/></svg>
      <svg id="chatIconClose" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#FBF4EA" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none;"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
  </div>

  <!-- Mini bot de suporte -->
  <div class="chat-panel" id="chatPanel">
    <div class="chat-header">
      <div>
        <div class="chat-header-title">Gleyci Felix</div>
        <div class="chat-header-sub" id="chatHeaderSub">Assistente virtual</div>
      </div>
    </div>
    <div class="chat-messages" id="chatMessages"></div>
    <div class="chat-quick" id="chatQuick"></div>
    <form class="chat-input-row" id="chatForm">
      <input type="text" id="chatInput" placeholder="…" autocomplete="off">
      <button type="submit" aria-label="Enviar">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
      </button>
    </form>
  </div>

  <footer>
    <div class="brand" style="justify-content:center; margin-bottom:8px;">
      <svg class="brand-mark" viewBox="0 0 72 72" fill="none">
        <circle class="ring" cx="36" cy="36" r="34.5"/>
        <text x="36" y="46" text-anchor="middle" font-size="30">GF</text>
      </svg>
      <span class="brand-word" style="color:var(--parchment); font-size:1.2rem;">Gleyci Felix</span>
    </div>
    <p>Lisboa, Portugal · &copy; <%= new Date().getFullYear() %> Hair Specialist Gleyci Felix. <%= T.footer_rights %></p>
  </footer>

  <!-- Modal Login/Registo -->
  <div class="modal-overlay" id="authModal">
    <div class="modal-box">
      <span class="modal-close" onclick="closeModal()">&times;</span>
      <div id="loginForm">
        <h2><%= T.login_title %></h2>
        <input type="email" id="loginEmail" placeholder="<%= T.email %>">
        <div class="password-field">
          <input type="password" id="loginPassword" placeholder="<%= T.password %>">
          <button type="button" class="password-toggle" onclick="togglePassword('loginPassword', this)" aria-label="<%= T.show_password %>">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
          </button>
        </div>
        <div class="form-error" id="loginError"></div>
        <button class="submit-btn" onclick="doLogin()"><%= T.login %></button>
        <div class="modal-switch" onclick="switchForm('register')"><%= T.no_account %></div>
      </div>
      <div id="registerForm" style="display:none;">
        <h2><%= T.register_title %></h2>
        <input type="text" id="regName" placeholder="<%= T.name %>">
        <input type="email" id="regEmail" placeholder="<%= T.email %>">
        <input type="text" id="regPhone" placeholder="<%= T.phone %>">
        <div class="password-field">
          <input type="password" id="regPassword" placeholder="<%= T.password %>">
          <button type="button" class="password-toggle" onclick="togglePassword('regPassword', this)" aria-label="<%= T.show_password %>">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
          </button>
        </div>
        <div class="form-error" id="regError"></div>
        <button class="submit-btn" onclick="doRegister()"><%= T.register_title %></button>
        <div class="modal-switch" onclick="switchForm('login')"><%= T.have_account %></div>
      </div>
    </div>
  </div>

  <!-- Modal Minhas Marcações -->
  <div class="modal-overlay" id="myBookingsModal">
    <div class="modal-box mybookings-box" style="max-width:480px;">
      <span class="modal-close" onclick="closeMyBookings()">&times;</span>
      <div class="mybookings-header">
        <svg class="brand-mark" viewBox="0 0 72 72" fill="none" width="40" height="40">
          <circle cx="36" cy="36" r="34.5" stroke="var(--gold)" stroke-width="1" fill="none"/>
          <text x="36" y="46" text-anchor="middle" font-family="Fraunces, serif" font-style="italic" font-size="30" fill="var(--gold)">GF</text>
        </svg>
        <div>
          <h2 style="margin-bottom:2px;"><%= T.my_bookings_title %></h2>
          <div class="mybookings-greeting"><% if (user) { %><%= lang === 'pt' ? 'Olá, ' : 'Hi, ' %><%= user.name.split(' ')[0] %><% } %></div>
        </div>
      </div>
      <div class="mybookings-list" id="myBookingsList"></div>
    </div>
  </div>

  <script>
    const LANG = "<%= lang %>";
    const IS_LOGGED_IN = <%= user ? 'true' : 'false' %>;
    const MSG_NO_SLOTS = "<%= T.no_slots %>";
    const MSG_SUCCESS = "<%= T.booking_success %>";
    const STATUS_LABELS = {
      pending: "<%= T.status_pending %>", confirmed: "<%= T.status_confirmed %>",
      cancelled: "<%= T.status_cancelled %>", rejected: "<%= T.status_rejected %>"
    };
    const NO_BOOKINGS_YET = "<%= T.no_bookings_yet %>";
    const CANCEL_LABEL = "<%= T.cancel_booking %>";
    const SERVICES_DATA = <%- JSON.stringify(services.map(s => ({
      name_pt: s.name_pt, name_en: s.name_en, price: s.price, duration: s.duration_minutes
    }))) %>;
    window.SERVICES_DATA = SERVICES_DATA;
    window.HOURS_DATA = <%- JSON.stringify(hours.map(h => ({
      weekday: h.weekday, active: h.active, start_time: h.start_time, end_time: h.end_time
    }))) %>;
  </script>
  <script src="/js/main.js"></script>
  <script src="/js/chatbot.js"></script>
</body>
</html>
