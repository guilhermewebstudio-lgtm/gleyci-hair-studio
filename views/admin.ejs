<!DOCTYPE html>
<html lang="pt">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Gestão | Gleyci Felix</title>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Poppins', sans-serif; background: #F7F1E8; margin: 0; padding: 40px 5%; color: #2B211C; }
    h1 { font-family: 'Playfair Display', serif; color: #4A2E22; margin-bottom: 30px; }
    table { width: 100%; border-collapse: collapse; background: white; border-radius: 10px; overflow: hidden; box-shadow: 0 4px 20px rgba(0,0,0,0.06); }
    th, td { padding: 14px 16px; text-align: left; border-bottom: 1px solid #eee; font-size: 0.92rem; }
    th { background: #4A2E22; color: white; }
    tr:hover { background: #fdf9f2; }
    .badge { background: #C9A15C; color: #1C1512; padding: 4px 10px; border-radius: 20px; font-size: 0.78rem; font-weight: 600; }
  </style>
</head>
<body>
  <h1>Painel de Gestão — Marcações</h1>
  <table>
    <thead>
      <tr>
        <th>Data</th><th>Hora</th><th>Cliente</th><th>Telefone</th><th>Email</th><th>Serviço</th>
      </tr>
    </thead>
    <tbody>
      <% bookings.forEach(b => { %>
        <tr>
          <td><%= new Date(b.booking_date).toLocaleDateString('pt-PT') %></td>
          <td><%= b.start_time.slice(0,5) %></td>
          <td><%= b.client_name %></td>
          <td><%= b.phone || '-' %></td>
          <td><%= b.email %></td>
          <td><span class="badge"><%= b.name_pt %></span></td>
        </tr>
      <% }) %>
      <% if (bookings.length === 0) { %>
        <tr><td colspan="6" style="text-align:center; color:#999;">Sem marcações no momento.</td></tr>
      <% } %>
    </tbody>
  </table>
</body>
</html>
